# AWS Configuration
AWS_REGION=us-east-1
AGENT_SPACE_ID=default

# AWS Secrets Manager & DynamoDB
JIRA_SECRET_NAME=devops-agent/jira-credentials
DYNAMODB_TABLE_NAME=devops-agent-jira-mappings
LOG_LEVEL=INFO

# Jira Cloud Credentials (stored in Secrets Manager)
JIRA_BASE_URL=https://mycompany.atlassian.net
JIRA_USER_EMAIL=admin@mycompany.com
JIRA_API_TOKEN=your_atlassian_api_token_here
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Incident
